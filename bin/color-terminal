#!/usr/bin/env bash
# color-terminal — development entrypoint.
#
# This file sources lib/*.sh from the checkout. The INSTALLED tool is a different
# artifact: `make dist` concatenates the same lib files into a single self-contained
# dist/color-terminal. That is not tidiness, it is the point — a single file can be
# scp'd to any host you ssh into, which is how v1 worked and how this has to keep
# working, and it saves ten open() calls on the hot path of every shell start.

set -uo pipefail

CT_REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The same list `make dist` concatenates, in the same order, read from the same file,
# so the checkout and the artifact cannot disagree about what the tool is made of.
while IFS= read -r f; do
    case "$f" in ''|'#'*) continue ;; esac
    # shellcheck source=/dev/null
    . "$CT_REPO_DIR/$f"
done < "$CT_REPO_DIR/lib/manifest"

# Source-guard: tests source this file to reach the functions without running the
# tool. Only execute when we are the process being run.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    ct_main "$@"
fi
